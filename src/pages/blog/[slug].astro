---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts, postUrl, description, dateLabel, readTime, topic, relatedPosts } from '../../lib/posts';
export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = relatedPosts(post, await publishedPosts());
const updated = post.data.updated || post.data.lastModified;
const url = new URL(postUrl(post), Astro.site).href;
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BlogPosting', headline: post.data.title, description: description(post), datePublished: post.data.date.toISOString(), dateModified: (updated || post.data.date).toISOString(), author: { '@type':'Person', name:post.data.author, url: new URL('/#about', Astro.site).href }, publisher: { '@type':'Organization', name:'Maximize 1031', url:Astro.site?.href }, mainEntityOfPage:url, image:new URL('/social.jpg', Astro.site).href },
  { '@type':'BreadcrumbList', itemListElement: [{ '@type':'ListItem', position:1, name:'Home', item:Astro.site?.href }, { '@type':'ListItem', position:2, name:'The journal', item:new URL('/blog', Astro.site).href }, { '@type':'ListItem', position:3, name:post.data.title, item:url }] },
]};
---
<Layout title={post.data.metaTitle || post.data.title} description={post.data.metaDescription || description(post)} type="article" schema={schema}>
  <Fragment slot="head"><meta property="article:published_time" content={post.data.date.toISOString()}/><meta property="article:modified_time" content={(updated || post.data.date).toISOString()}/><meta name="author" content={post.data.author}/></Fragment>
  <article class="wrap article-page">
    <nav aria-label="Breadcrumb" class="breadcrumbs"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">The journal</a></nav>
    <header class="article-header"><p class="eyebrow">{topic(post)} <span>·</span> {readTime(post)} min read</p><h1>{post.data.title}</h1><p class="article-deck">{description(post)}</p><div class="article-byline"><span class="author-avatar" aria-hidden="true">ST</span><div><a href="/#about">{post.data.author}</a><p><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>{updated && updated > post.data.date && <> · Updated <time datetime={updated.toISOString()}>{dateLabel(updated)}</time></>}</p></div></div></header>
    <div class="article-layout">
      {headings.some(h => h.depth === 2) && <aside class="article-toc"><p class="eyebrow">In this guide</p><nav aria-label="Table of contents">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav><a class="text-link" href="/contact">Have a question? ↗</a></aside>}
      <div class="article-main"><div class="prose"><Content/></div><aside class="disclaimer"><strong>A note before you act</strong><p>This article is for educational purposes only. It does not constitute tax, legal, or investment advice. Discuss your circumstances with your CPA, attorney, and qualified intermediary.</p></aside><div class="article-contact"><h2>Questions about your next move?</h2><p>Call <a href="tel:+18184822707">(818) 482-2707</a> or <a href="mailto:info@maximize1031.com">email Shant</a>.</p></div></div>
    </div>
  </article>
  {related.length > 0 && <section class="wrap related-section"><div class="section-heading"><h2>Keep exploring.</h2><a href="/blog" class="text-link">All articles ↗</a></div><div class="article-grid">{related.map(p => <PostCard post={p}/>)}</div></section>}
</Layout>
