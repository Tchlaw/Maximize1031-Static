---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts, postUrl } from '../lib/posts';
const posts = await publishedPosts();
const featured = posts.find(p => p.data.featured) || posts[0];
const recent = posts.filter(p => p.id !== featured?.id).slice(0, 3);
const faqs = [
  ['Where should I start?', 'Start with the exchange basics guide, then explore the questions that match your property and plans.'],
  ['Do you cover California questions?', 'Yes. The journal includes California reporting considerations, ownership structures, and property loss topics.'],
  ['Is an article advice for my transaction?', 'No. The journal is educational. Your CPA, attorney, and qualified intermediary should evaluate your specific circumstances.'],
  ['How can I get in touch?', 'Call (818) 482-2707 or email info@maximize1031.com.'],
];
---
<Layout title="1031 exchange guides" description="Practical 1031 exchange guides. Explore replacement property, California considerations, exchange funds, and ownership planning." schema={{'@context':'https://schema.org','@type':'Organization',name:'Maximize 1031',url:Astro.site?.href,email:'info@maximize1031.com',telephone:'+1-818-482-2707'}}>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> The 1031 journal</p>
      <h1>Understand your<br/>1031 exchange.<br/><span>Plan your next move.</span></h1>
      <p class="hero-description">Explore the fundamentals, the planning questions, and the details worth discussing before you sell.</p>
      <a class="button" href="/blog">Explore the guides <span aria-hidden="true">↗</span></a>
      <p class="hero-note">Written by Shant Tchakerian <span>·</span></p>
    </div>
    <div class="hero-feature">{featured && <PostCard post={featured} featured/>}</div>
  </section>
  <section class="journal-section wrap reveal" id="journal">
    <div class="section-heading"><a class="text-link" href="/blog">View all articles <span aria-hidden="true">↗</span></a></div>
    <div class="article-grid">{recent.map(post => <PostCard post={post}/>)}</div>
  </section>

  <section id="about" class="about-section wrap reveal"><div><p class="eyebrow">About Maximize 1031</p><h2>Practical perspective.<br/>A personal connection.</h2></div><div><p class="about-lead">I’m Shant Tchakerian. I write about the property decisions and planning questions that come up around a 1031 exchange.</p><p>Maximize 1031 helps property owners coordinate exchange timelines, documentation, and replacement property identification. This journal is a place to understand the questions before you start the conversation.</p><a class="text-link" href="mailto:info@maximize1031.com">Email Shant <span aria-hidden="true">↗</span></a></div></section>
  <section class="faq-section wrap reveal"><div class="section-heading"><div><p class="eyebrow">Before you begin</p><h2>A few useful answers.</h2></div></div><div class="faq-grid">{faqs.map(([q,a]) => <div><h3>{q}</h3><p>{a}</p></div>)}</div></section>
  <section id="contact" class="contact-section wrap reveal"><p class="eyebrow">Let’s connect</p><h2>Have a question about<br/>your next move?</h2><p>A referral, a question, or an introduction.<br/>A call or an email is the best place to start.</p><div class="contact-links"><a href="tel:+18184822707">(818) 482-2707 <span aria-hidden="true">↗</span></a><a href="mailto:info@maximize1031.com">info@maximize1031.com <span aria-hidden="true">↗</span></a></div><a class="text-link" href="/blog">Explore the guides <span aria-hidden="true">↗</span></a></section>
</Layout>
